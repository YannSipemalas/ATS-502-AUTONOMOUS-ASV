<?xml version="1.0"?>
<!-- URDF untuk RViz (cermin dari models/robot/model.sdf). Path mesh diisi oleh run_rviz.sh -->
<robot name="robot">
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="file://@ROOT@/models/robot/meshes/robot_body.stl"/></geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0.115 0 0.008"/>
      <geometry><sphere radius="0.008"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.05 0 0.06"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.01 0.025 0.025"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.16 0 0.085" rpy="0 0.25 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 0"/>
      <geometry><box size="0.02 0.006 0.027"/></geometry>
      <material name="white"/>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.09325 0.035" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.02 0 0"/>
      <geometry><box size="0.02 0.006 0.027"/></geometry>
      <material name="white"/>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.09325 0.035" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
