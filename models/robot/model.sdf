<?xml version="1.0" ?>
<!--
  Robot diferensial (dari robot.stl). Frame: X depan, Y kiri, Z atas.
  Origin model = lantai, tepat di bawah titik tengah poros roda.
  Ukuran hasil ukur CAD: panjang ~0.204 m, lebar luar roda ~0.212 m, tinggi ~0.108 m.
  Roda: r = 0.035 m, jarak antar roda (track) = 0.1865 m.
  Komponen: kamera (lantai 2 depan), mini PC (lantai 2), LiPo, 2 roda + encoder, caster depan.
-->
<sdf version="1.9">
  <model name="robot">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint"/>

    <!-- ===== BADAN ===== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- badan + mini PC + LiPo ~1.3 kg, titik berat agak ke depan & rendah -->
        <pose>0.05 0 0.05 0 0 0</pose>
        <mass>1.3</mass>
        <inertia>
          <ixx>0.0050</ixx><iyy>0.0055</iyy><izz>0.0085</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry><mesh><uri>model://robot/meshes/robot_body.stl</uri></mesh></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
      </visual>
      <!-- collision disederhanakan jadi box (ringan untuk fisika) -->
      <collision name="body_collision">
        <pose>0.063 0 0.06 0 0 0</pose>
        <geometry><box><size>0.20 0.15 0.09</size></box></geometry>
      </collision>
      <!-- caster bola depan (licin, radius diperbesar 8->12 mm) -->
      <collision name="caster_front_collision">
        <pose>0.115 0 0.012 0 0 0</pose>
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_front_visual">
        <pose>0.115 0 0.012 0 0 0</pose>
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>

      <!-- ===== IMU ===== -->
      <sensor name="imu" type="imu">
        <pose>0.05 0 0.06 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <!-- ===== KAMERA (lantai 2 depan) ===== -->
    <link name="camera_link">
      <pose>0.16 0 0.085 0 0.25 0</pose>
      <inertial><mass>0.02</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v">
        <geometry><box><size>0.01 0.025 0.025</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.3963</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.005</near><far>20</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- ===== RODA KIRI ===== -->
    <link name="left_wheel">
      <pose>0 0.09325 0.035 -1.5708 0 0</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>3.6e-5</ixx><iyy>3.6e-5</iyy><izz>6.1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.035</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.035</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="marker">
        <pose>0.02 0 0 0 0 0</pose>
        <geometry><box><size>0.02 0.006 0.027</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ===== RODA KANAN ===== -->
    <link name="right_wheel">
      <pose>0 -0.09325 0.035 -1.5708 0 0</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>3.6e-5</ixx><iyy>3.6e-5</iyy><izz>6.1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.035</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.035</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="marker">
        <pose>0.02 0 0 0 0 0</pose>
        <geometry><box><size>0.02 0.006 0.027</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ===== PLUGIN ===== -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.1865</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <!-- Encoder roda: posisi & kecepatan joint dipublish ke topic joint_states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
